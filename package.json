{
  "name": "ai-usage-observatory",
  "version": "1.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node --input-type=module -e \"import{cpSync,mkdirSync}from'node:fs';mkdirSync('dist/server/assets/migrations',{recursive:true});cpSync('src/db/migrations','dist/server/assets/migrations',{recursive:true});\"",
    "start": "node start.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts,.tsx",
    "check:version": "node scripts/check-version-sync.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-table": "8.21.3",
    "better-sqlite3": "12.11.1",
    "decimal.js": "10.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "srvx": "^0.11.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "9.39.5",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
